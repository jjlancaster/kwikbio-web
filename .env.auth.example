# M-AUTH — kwikbio-web auth configuration (Jewel)
#
# Secrets come from the ENVIRONMENT here, not Google Secret Manager. The
# hydrojoule portal uses GCP Secret Manager because it runs on GCP; Jewel has
# no GCP credentials, so do not copy hydrojoule's lib/secrets.ts over.
#
# Sign-in providers are registered only if their variables are present, so a
# box with no SMTP yet still boots — it just offers fewer ways to sign in.
# With NO provider configured the site still works: the open Easy search
# (freemium) never requires an account.

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public origin, used to build magic-link callback URLs.
AUTH_URL=https://kwikbio.com
AUTH_TRUST_HOST=true

# ── Google OAuth (optional) ──────────────────────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email magic link (optional) ──────────────────────────────────────────────
# EMAIL_SERVER_USER/PASSWORD may be omitted for an unauthenticated internal relay.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=no-reply@kwikbio.com

# ── Database ─────────────────────────────────────────────────────────────────
# Same local Postgres the rest of the app uses (lib/db/pg.ts).
# Apply the schema once:  psql $DATABASE_URL < db/auth.sql
PG_HOST=localhost
PG_PORT=5432
PG_USER=kwikbio
PG_PASSWORD=
PG_DATABASE=kwikbio
