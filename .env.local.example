# App
NEXT_PUBLIC_APP_URL=https://kwikbio.com
NEXT_PUBLIC_API_URL=https://kwikbio.com/api
NEXT_PUBLIC_SITE_URL=https://kwikbio.com

# Staging overrides (Aqua VPS2)
# NEXT_PUBLIC_APP_URL=http://aquajewel.ai:3003
# NEXT_PUBLIC_API_URL=http://aquajewel.ai:3003/api

# Internal services (Jewel loopback)
KWIKBIO_API_INTERNAL=http://127.0.0.1:3002
ARS_GATEWAY_INTERNAL=http://127.0.0.1:5000

# Auth — shared secret with the kwikbio API for JWT signature verification.
# REQUIRED in production. When unset, the app decodes JWTs without verifying
# their signature (local scaffolding only — never deploy without this set).
JWT_SECRET=

# ARS anonymous demo rate limit (homepage)
NEXT_PUBLIC_ARS_RATE_LIMIT_ANONYMOUS=1

# Stripe (placeholder until billing sprint)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Analytics
NEXT_PUBLIC_GA_ID=

# Email
EMAIL_FROM=noreply@kwikbio.com
