icable, a Business Associate Agreement. Until such an agreement is countersigned, the freemium-tier prohibitions in §4 apply to all tiers."}],["$","h2",null,{"children":"10. Governing law"}],["$","p",null,{"children":"Delaware, USA. Disputes resolve in Wilmington courts."}],["$","h2",null,{"children":"11. Changes"}],["$","p",null,{"children":"We may update these Terms with 30 days' email notice. Continued use after the effective date constitutes acceptance."}],["$","h2",null,{"children":"12. Contact"}],["$","p",null,{"children":"legal@kwikbio.com — kwiKBio Inc., c/o HydroJoule LLC."}]]}],null,["$","$L5",null,{"children":"$L6"}]]}],{},null,false]},null,false]},null,false]},null,false],["$","$1","h",{"children":[null,["$","$1","3Yker3r1fi5gddO-S4OQ-",{"children":[["$","$L7",null,{"children":"$L8"}],["$","$L9",null,{"children":"$La"}],null]}]]}],false]],"m":"$undefined","G":["$b","$undefined"],"s":false,"S":true}
